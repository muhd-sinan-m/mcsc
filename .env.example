DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
DATABASE_URL=postgresql://mcsc_user:your-db-password@localhost:5432/mcsc_db
DB_CONN_MAX_AGE=600
POSTGRES_DB=mcsc_db
POSTGRES_USER=mcsc_user
POSTGRES_PASSWORD=your-db-password
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://yourdomain.com


# Google OAuth2 Settings
GOOGLE_OAUTH2_KEY=your-google-client-id
GOOGLE_OAUTH2_SECRET=your-google-client-secret

# Email settings for notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MCSC Portal <your-email@gmail.com>
